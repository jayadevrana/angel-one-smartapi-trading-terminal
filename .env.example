DATABASE_URL="postgresql://postgres:postgres@localhost:5432/angel_trading_terminal?schema=public"
APP_JWT_SECRET="replace-with-a-long-random-secret"

# Server-side shared Angel One SmartAPI credentials.
# Keep these on the server. Do not expose them with NEXT_PUBLIC_.
ANGEL_API_KEY=""
ANGEL_CLIENT_CODE=""
ANGEL_PASSWORD=""
ANGEL_TOTP_SECRET=""
ANGEL_CLIENT_LOCAL_IP="127.0.0.1"
ANGEL_CLIENT_PUBLIC_IP="127.0.0.1"
ANGEL_MAC_ADDRESS="00:00:00:00:00:00"

# Set to false when live Angel credentials are configured and market is available.
USE_MOCK_MARKET_DATA="true"
